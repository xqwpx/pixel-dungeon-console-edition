#pragma once

#include <cstddef>
#include <cstdint>

namespace std {

// Compact freestanding MT19937 implementation. It preserves the engine type
// consumed by game/utils/Random.cpp without depending on libstdc++.
class mt19937 {
public:
    using result_type = uint32_t;
    static constexpr result_type min() { return 0u; }
    static constexpr result_type max() { return 0xffffffffu; }

    explicit mt19937(result_type seedValue = 5489u) { seed(seedValue); }
    void seed(result_type seedValue = 5489u) {
        state_[0] = seedValue;
        for (size_t index = 1; index < StateSize; ++index)
            state_[index] = 1812433253u * (state_[index - 1] ^ (state_[index - 1] >> 30)) + static_cast<result_type>(index);
        index_ = StateSize;
    }
    result_type operator()() {
        if (index_ >= StateSize) twist();
        result_type value = state_[index_++];
        value ^= value >> 11;
        value ^= (value << 7) & 0x9d2c5680u;
        value ^= (value << 15) & 0xefc60000u;
        value ^= value >> 18;
        return value;
    }

private:
    static constexpr size_t StateSize = 624;
    static constexpr size_t MiddleWord = 397;
    void twist() {
        for (size_t index = 0; index < StateSize; ++index) {
            const result_type bits = (state_[index] & 0x80000000u) | (state_[(index + 1) % StateSize] & 0x7fffffffu);
            result_type value = state_[(index + MiddleWord) % StateSize] ^ (bits >> 1);
            if (bits & 1u) value ^= 0x9908b0dfu;
            state_[index] = value;
        }
        index_ = 0;
    }

    result_type state_[StateSize]{};
    size_t index_ = StateSize;
};

template <typename Int>
class uniform_int_distribution {
public:
    uniform_int_distribution(Int minValue = 0, Int maxValue = 1) : min_(minValue), max_(maxValue) {}
    template <typename Engine>
    Int operator()(Engine& engine) const {
        const uint32_t span = static_cast<uint32_t>(max_ - min_) + 1u;
        if (!span) return static_cast<Int>(engine());
        const uint32_t limit = 0xffffffffu - (0xffffffffu % span);
        uint32_t value;
        do { value = static_cast<uint32_t>(engine()); } while (value >= limit);
        return static_cast<Int>(min_ + static_cast<Int>(value % span));
    }

private:
    Int min_;
    Int max_;
};

template <typename Real, size_t Bits, typename Engine>
Real generate_canonical(Engine& engine) {
    (void)Bits;
    return static_cast<Real>(engine()) * static_cast<Real>(1.0 / 4294967296.0);
}

} // namespace std
