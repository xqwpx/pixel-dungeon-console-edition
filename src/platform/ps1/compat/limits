#pragma once

namespace std {
template <typename T> struct numeric_limits;
template <> struct numeric_limits<int> { static constexpr int max() { return 0x7fffffff; } };
template <> struct numeric_limits<float> {
    static constexpr float max() { return 3.402823466e+38F; }
    static constexpr float min() { return 1.175494351e-38F; }
    static constexpr float infinity() { return 1.0F / 0.0F; }
};
} // namespace std
